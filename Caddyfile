# 217 — local development proxy: Flutter web UI + Go API (same origin for cookie AuthKit).
:8080 {
    encode gzip

    handle /api/* {
        reverse_proxy backend:3000
    }

    # SPA fallback so deep links / refresh serve the Flutter shell.
    handle {
        root * /srv/web
        try_files {path} /index.html
        file_server
    }
}
