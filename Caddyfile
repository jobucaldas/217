# 217 — local development proxy. Use a trusted HTTPS hostname for physical Android Push testing.
:8080 {
    encode gzip

    handle /api/* {
        reverse_proxy backend:3000
    }

    handle /service-worker.js {
        root * /srv/frontend
        header Cache-Control "no-cache, no-store, must-revalidate"
        file_server
    }

    handle {
        root * /srv/frontend
        try_files {path} /index.html
        file_server
    }
}
