:8080

header {
	Referrer-Policy "no-referrer"
	X-Content-Type-Options "nosniff"
	X-Frame-Options "DENY"
	# Flutter ships CanvasKit locally (--no-web-resources-cdn). google_fonts may
	# fetch Fraunces / Source Sans 3; connect-src must allow fonts.gstatic.com.
	Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://fonts.gstatic.com https://fonts.googleapis.com; worker-src 'self' blob:; manifest-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'"
}

handle /api/* {
	reverse_proxy app-217-backend:3000
}

handle /healthz {
	reverse_proxy app-217-backend:3000
}

handle /readyz {
	reverse_proxy app-217-backend:3000
}

handle {
	root * /usr/share/caddy/html
	try_files {path} /index.html
	file_server
}
