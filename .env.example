# Database password: create your own, e.g. openssl rand -hex 24
POSTGRES_PASSWORD=
# Encrypts personal data before it is stored: create your own, e.g. openssl rand -base64 32
# Losing it makes the stored data unreadable. To rotate, move the old key to
# DATA_ENCRYPTION_KEY_PREVIOUS and restart.
DATA_ENCRYPTION_KEY=
# DATA_ENCRYPTION_KEY_PREVIOUS=
APP_BASE_URL=http://localhost:8787
# Optional host bind for Caddy (maps to container :8787). Default 8787 avoids :8080 clashes.
# HTTP_PORT=8787
# Your own WorkOS project (https://workos.com): public client ID and secret API key.
WORKOS_CLIENT_ID=
# Server-only secret. Sign-in works without it; "Delete account" needs it to remove the WorkOS user.
# Put the real value in your ignored .env (copy this file), never here.
WORKOS_API_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:notifications@example.com
