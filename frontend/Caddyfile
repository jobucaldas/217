# 217 web: the Flutter bundle plus the Go API on one origin (cookie AuthKit needs it).
#
# SITE_ADDRESS      ":8787" (plain HTTP, the default) or a domain for automatic HTTPS
# BACKEND_UPSTREAM  where the API listens; "https://backend:3000" encrypts this hop
#                   too (the API's CA must be trusted, e.g. SSL_CERT_DIR=/certs)
{$SITE_ADDRESS::8787} {
    encode gzip

    header {
        # Browsers only honor HSTS on HTTPS responses, so plain-HTTP tryouts are unaffected.
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        X-Frame-Options "DENY"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'"
        -Server
    }

    handle /api/* {
        reverse_proxy {$BACKEND_UPSTREAM:backend:3000}
    }

    # The web engine's fallback fonts (web/flutter_bootstrap.js), fetched by
    # this server so Google sees neither the user's address nor their headers.
    handle_path /gstatic/* {
        reverse_proxy https://fonts.gstatic.com {
            header_up Host fonts.gstatic.com
            header_up -Cookie
            header_up -Authorization
            header_up -Referer
            header_up -Origin
            header_up -Accept-Language
            header_up User-Agent "217"
            header_up -X-Forwarded-For
            header_up -X-Forwarded-Host
            header_up -X-Forwarded-Proto
            header_up -Via
            header_down -Set-Cookie
        }
    }

    # The web app lives under /app/ (built with --base-href /app/), so the API
    # keeps the root of the origin. SPA fallback so deep links / refresh serve
    # the Flutter shell. Revalidate on every load (ETag keeps it cheap) so a new
    # deploy shows up at once instead of an old bundle lingering in the cache.
    @appBare path /app
    handle @appBare {
        @withQuery expression {query} != ""
        redir @withQuery /app/?{query} 308
        redir * /app/ 308
    }

    # Missing files (.js, .wasm, .png...) must 404; only extension-less paths
    # that are not real files fall back to the shell.
    handle_path /app/* {
        root * /app/dist
        header Cache-Control "no-cache"
        @spa {
            not file
            not path_regexp \.[A-Za-z0-9]+$
        }
        rewrite @spa /index.html
        file_server
    }

    # Sign-in and invite links go to /app/ directly; older links (/?invite=...,
    # the bare origin) still land in the app. Everything else is not found.
    @origin {
        method GET HEAD
        path /
    }
    handle @origin {
        redir * /app{uri} 302
    }

    handle {
        respond "Not found" 404
    }
}
