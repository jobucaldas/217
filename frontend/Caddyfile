# 217 — local (compose) proxy: Flutter web UI + Go API (same origin for cookie AuthKit).
# Host port defaults to 8787 (avoids common :8080 conflicts / port-forward clashes).
:8787 {
    encode gzip

    handle /api/* {
        reverse_proxy backend:3000
    }

    # SPA fallback so deep links / refresh serve the Flutter shell.
    handle {
        root * /srv/web
        try_files {path} /index.html
        file_server
    }
}
